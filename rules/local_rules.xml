<!--
  Custom Wazuh rules — local_rules.xml  (SANITIZED PORTFOLIO VERSION)
  All IPs / hostnames / identifiers masked with XXX.
  This ONE file holds BOTH tuning rules and detection rules (Wazuh reads a
  single custom rules file). Comments mark which is which.
  Custom rule IDs use the 100000+ range (Wazuh convention for user rules).
-->

<!-- ==========================================================
     Firewall (Sophos XG) — existing rules
     ========================================================== -->
<group name="sophos,firewall,">
  <rule id="100100" level="3">
    <match>device_name="XXX-firewall"</match>
    <description>Sophos XG Firewall event</description>
  </rule>
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <match>log_subtype="Denied"</match>
    <description>Sophos XG: Traffic denied by firewall</description>
  </rule>
</group>

<!-- ==========================================================
     Windows authentication — tuning + detection
     Base rule 60122 = single Windows failed logon (event 4625).
     ========================================================== -->
<group name="windows,authentication,">

  <!-- TUNING (see docs/tuning-log.md):
       Down-rank Logon Type 5 (service) failed logons. These are benign service
       authentication failures (computer account, svchost.exe, no source IP),
       not real login attempts. Level 2 keeps them below the alert threshold. -->
  <rule id="100200" level="2">
    <if_sid>60122</if_sid>
    <field name="win.eventdata.logonType">^5$</field>
    <description>Windows failed logon - service account (Logon Type 5), benign noise</description>
  </rule>

  <!-- DETECTION (see matrix/mitre-coverage.md):
       Brute force = 8+ REAL remote failed logons (Logon Type 3 network / 10 RDP)
       within 120s. Scoped away from Type 5 noise. Threshold sits above the
       measured normal failed-logon floor. -->
  <rule id="100201" level="10" frequency="8" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <field name="win.eventdata.logonType">^3$|^10$</field>
    <description>Windows brute force - 8+ remote failed logons (Type 3/10) in 120s</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

</group>

